# WSA-Next - Indonesian language file (Bahasa Indonesia).
# Format: ID=text, UTF-8, escapes \n \r \t \\ ; keep every {...} placeholder.
# English, the reference, is built into WSA-Next.exe ("WSA-Next.exe lng-export en.lng").
#name=Bahasa Indonesia
#locale=id

