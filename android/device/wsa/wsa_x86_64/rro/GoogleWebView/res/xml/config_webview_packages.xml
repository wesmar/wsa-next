<?xml version="1.0" encoding="utf-8"?>
<!-- WSA-Next © 2026 Marek Wesołowski - wesmar
     Google Play variant: Google's WebView, as on a phone. It is preinstalled together with Chrome
     and their Trichrome library, one version with x86 and x86_64 libraries (32-bit apps load
     WebView too), and Google Play keeps it current. AOSP's WebView is not in this variant
     (WebViewGoogle overrides it): it would never be updated. Android 15's
     WebViewUpdateServiceImpl2 uses the first provider marked availableByDefault. -->
<webviewproviders>
    <webviewprovider description="Android System WebView" packageName="com.google.android.webview"
        availableByDefault="true">
        <signature></signature>
    </webviewprovider>
</webviewproviders>
