+package com.android.mms.service;
+
+import android.net.LocalSocket;
+import android.net.LocalSocketAddress;
+
+import java.io.Closeable;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.Proxy;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * WSA-Next (Windows Subsystem for Android): the SIM is in the PC's modem, which Windows drives,
+ * and Android has no cellular network of its own. MMS go this way instead:
+ *
+ * <pre>
+ *   MmsHttpClient -> loopback tunnel (here) -> /dev/socket/wsa_mms (the wsa-mms daemon)
+ *     -> vsock -> WSA-Next on Windows: opens the APN on the modem and connects to the server
+ * </pre>
+ *
+ * The tunnel's first line names the APN and the server (the APN's MMS proxy, or the MMS server
+ * itself); Windows answers "OK" once connected, then the bytes go through unchanged. One tunnel
+ * carries one HTTP exchange.
+ */
+final class WsaMmsRelay {
+    /** The net ID MmsNetworkManager reports: there is no Android network. */
+    static final int NET_ID = 0;
+
+    private static final String SOCKET_NAME = "wsa_mms";
+    private static final File SOCKET_FILE = new File("/dev/socket/" + SOCKET_NAME);
+    // A guard: Windows answers as soon as the APN is up and the server took the connection.
+    private static final int ANSWER_TIMEOUT_MS = 60 * 1000;
+    private static final int MAX_LINE = 1024;
+
+    private WsaMmsRelay() {}
+
+    /** True on WSA-Next, whose relay daemon owns the socket. */
+    static boolean isAvailable() {
+        return SOCKET_FILE.exists();
+    }
+
+    /**
+     * Asks the host for a connection to the APN's MMS proxy (when set) or to the server of `url`,
+     * through the APN.
+     */
+    static Tunnel open(ApnSettings apn, URL url, boolean isProxySet, String proxyHost,
+            int proxyPort, String requestId) throws IOException {
+        final boolean https = "https".equalsIgnoreCase(url.getProtocol());
+        final String host = isProxySet ? proxyHost : url.getHost();
+        final int port = isProxySet ? proxyPort
+                : (url.getPort() != -1 ? url.getPort() : url.getDefaultPort());
+        final LocalSocket relay = new LocalSocket();
+        try {
+            relay.connect(new LocalSocketAddress(SOCKET_NAME,
+                    LocalSocketAddress.Namespace.RESERVED));
+            relay.setSoTimeout(ANSWER_TIMEOUT_MS);
+            final String request = "MMS\t" + field(apn.getApn()) + '\t' + apn.getAuthType()
+                    + '\t' + field(apn.getUser()) + '\t' + field(apn.getPassword())
+                    + '\t' + field(host) + '\t' + port + '\n';
+            relay.getOutputStream().write(request.getBytes(StandardCharsets.UTF_8));
+            final String answer = readLine(relay.getInputStream());
+            if (!"OK".equals(answer)) {
+                throw new IOException("WSA-Next host: " + answer);
+            }
+            relay.setSoTimeout(0);
+            LogUtil.i(requestId, "HTTP: through the WSA-Next host, APN " + apn.getApn());
+            return new Tunnel(relay, https && !isProxySet, isProxySet || https);
+        } catch (IOException e) {
+            closeQuietly(relay);
+            throw e;
+        }
+    }
+
+    /** One HTTP exchange through the host: a loopback listener for a single connection. */
+    static final class Tunnel implements Closeable {
+        private final LocalSocket mRelay;
+        private final ServerSocket mServer;
+        // https straight to the server: the client's CONNECT is answered here (the host has
+        // already connected to the server).
+        private final boolean mAnswerConnect;
+        // The loopback end acts as the client's HTTP proxy (an MMS proxy, or https).
+        private final boolean mAsProxy;
+        private volatile Socket mClient;
+
+        Tunnel(LocalSocket relay, boolean answerConnect, boolean asProxy) throws IOException {
+            mRelay = relay;
+            mAnswerConnect = answerConnect;
+            mAsProxy = asProxy;
+            mServer = new ServerSocket(0, 1, InetAddress.getLoopbackAddress());
+            final Thread thread = new Thread(this::serve, "WsaMmsRelay");
+            thread.setDaemon(true);
+            thread.start();
+        }
+
+        HttpURLConnection openConnection(URL url) throws IOException {
+            final InetSocketAddress local =
+                    new InetSocketAddress(InetAddress.getLoopbackAddress(), mServer.getLocalPort());
+            if (mAsProxy) {
+                return (HttpURLConnection) url.openConnection(new Proxy(Proxy.Type.HTTP, local));
+            }
+            // Straight to the MMS server: the loopback end in the URL, the server's name in Host.
+            final URL direct = new URL("http", local.getAddress().getHostAddress(),
+                    local.getPort(), url.getFile());
+            final HttpURLConnection connection =
+                    (HttpURLConnection) direct.openConnection(Proxy.NO_PROXY);
+            connection.setRequestProperty("Host",
+                    url.getPort() != -1 ? url.getHost() + ":" + url.getPort() : url.getHost());
+            return connection;
+        }
+
+        private void serve() {
+            try (Socket client = mServer.accept()) {
+                mClient = client;
+                closeQuietly(mServer);
+                final InputStream fromClient = client.getInputStream();
+                final OutputStream toClient = client.getOutputStream();
+                if (mAnswerConnect) {
+                    skipHeader(fromClient);
+                    toClient.write("HTTP/1.1 200 Connection established\r\n\r\n"
+                            .getBytes(StandardCharsets.US_ASCII));
+                    toClient.flush();
+                }
+                final Thread upstream = new Thread(() -> {
+                    try {
+                        copy(fromClient, mRelay.getOutputStream());
+                        mRelay.shutdownOutput();
+                    } catch (IOException e) {
+                        // The tunnel ends
+                    }
+                }, "WsaMmsRelay-up");
+                upstream.setDaemon(true);
+                upstream.start();
+                copy(mRelay.getInputStream(), toClient);
+                client.shutdownOutput();
+                upstream.join();
+            } catch (IOException | InterruptedException e) {
+                // close(), or a side went away
+            } finally {
+                close();
+            }
+        }
+
+        @Override
+        public void close() {
+            closeQuietly(mServer);
+            closeQuietly(mClient);
+            closeQuietly(mRelay);
+        }
+    }
+
+    private static String field(String value) {
+        return value == null ? "" : value.replace('\t', ' ').replace('\r', ' ').replace('\n', ' ');
+    }
+
+    private static String readLine(InputStream in) throws IOException {
+        final StringBuilder line = new StringBuilder();
+        for (;;) {
+            final int c = in.read();
+            if (c < 0) {
+                throw new IOException("WSA-Next host gave no answer");
+            }
+            if (c == '\n') {
+                return line.toString();
+            }
+            if (line.length() >= MAX_LINE) {
+                throw new IOException("WSA-Next host: answer too long");
+            }
+            line.append((char) c);
+        }
+    }
+
+    // The header of the client's CONNECT request, up to the empty line.
+    private static void skipHeader(InputStream in) throws IOException {
+        int matched = 0;  // of "\r\n\r\n"
+        for (int count = 0; matched < 4; ++count) {
+            final int c = in.read();
+            if (c < 0 || count > 16 * 1024) {
+                throw new IOException("no CONNECT request");
+            }
+            matched = (c == '\r' && (matched == 0 || matched == 2)) ? matched + 1
+                    : (c == '\n' && (matched == 1 || matched == 3)) ? matched + 1
+                    : (c == '\r') ? 1 : 0;
+        }
+    }
+
+    private static void copy(InputStream in, OutputStream out) throws IOException {
+        final byte[] buffer = new byte[16 * 1024];
+        int count;
+        while ((count = in.read(buffer)) > 0) {
+            out.write(buffer, 0, count);
+            out.flush();
+        }
+    }
+
+    private static void closeQuietly(Closeable closeable) {
+        if (closeable == null) {
+            return;
+        }
+        try {
+            closeable.close();
+        } catch (IOException e) {
+            // Already closed
+        }
+    }
+}
