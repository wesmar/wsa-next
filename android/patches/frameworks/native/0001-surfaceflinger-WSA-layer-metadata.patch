+// Windows Subsystem for Android: the host composer shows every Android task as its own
+// Windows window and assigns each layer to one of them through these generic metadata
+// keys. Values: task id (int32, only when known), window type (int32), secure (bool).
+constexpr char kWsaTaskIdKey[] = "com.microsoft.wsa.taskid";
+constexpr char kWsaWindowTypeKey[] = "com.microsoft.wsa.windowtype";
+constexpr char kWsaSecureKey[] = "com.microsoft.wsa.secure";
+
+std::vector<uint8_t> int32ToBytes(int32_t value) {
+    std::vector<uint8_t> bytes(sizeof(value));
+    memcpy(bytes.data(), &value, sizeof(value));
+    return bytes;
+}
+
+void updateWsaMetadata(LayerSnapshot& snapshot, const RequestedLayerState& requested,
+                       const LayerSnapshot& parentSnapshot) {
+    snapshot.wsaTaskId = requested.metadata.has(gui::METADATA_TASK_ID)
+            ? requested.metadata.getInt32(gui::METADATA_TASK_ID, 0)
+            : parentSnapshot.wsaTaskId;
+    snapshot.metadata.erase(kWsaTaskIdKey);
+    snapshot.metadata.erase(kWsaWindowTypeKey);
+    snapshot.metadata.erase(kWsaSecureKey);
+    if (snapshot.wsaTaskId > 0) {
+        snapshot.metadata.emplace(kWsaTaskIdKey,
+                                  compositionengine::GenericLayerMetadataEntry{
+                                          false, int32ToBytes(snapshot.wsaTaskId)});
+    }
+    snapshot.metadata.emplace(kWsaWindowTypeKey,
+                              compositionengine::GenericLayerMetadataEntry{
+                                      false,
+                                      int32ToBytes(requested.metadata.getInt32(
+                                              gui::METADATA_WINDOW_TYPE, 0))});
+    snapshot.metadata.emplace(kWsaSecureKey,
+                              compositionengine::GenericLayerMetadataEntry{
+                                      false,
+                                      std::vector<uint8_t>{
+                                              static_cast<uint8_t>(snapshot.isSecure ? 1 : 0)}});
+}
