tombstoned: fall back to named temporary files without O_TMPFILE.

Windows Subsystem for Android shares /data/tombstones (and /data/anr) with the host
over virtiofs, which has no O_TMPFILE on its kernel: tombstoned aborted on every crash
("failed to create temporary tombstone ... Operation not supported") and no crash
report reached the host. Write to a named ".temporaryN" file in that case and rename
it into place.

diff --git a/debuggerd/tombstoned/tombstoned.cpp b/debuggerd/tombstoned/tombstoned.cpp
index 2c72379..12a88e1 100644
--- a/debuggerd/tombstoned/tombstoned.cpp
+++ b/debuggerd/tombstoned/tombstoned.cpp
@@ -62,6 +62,10 @@ enum CrashStatus {
 struct CrashArtifact {
   unique_fd fd;
 
+  // Name of the file inside the queue directory when O_TMPFILE is not supported there
+  // (virtiofs shares, e.g. Windows Subsystem for Android); empty for O_TMPFILE files.
+  std::string temporary_name;
+
   static CrashArtifact devnull() {
     CrashArtifact result;
     result.fd.reset(open("/dev/null", O_WRONLY | O_CLOEXEC));
@@ -146,6 +150,13 @@ class CrashQueue {
 
     std::optional<std::string> path;
     result.fd.reset(openat(dir_fd_, ".", O_WRONLY | O_APPEND | O_TMPFILE | O_CLOEXEC, 0660));
+    if (result.fd == -1 && (errno == EOPNOTSUPP || errno == EISDIR || errno == EINVAL)) {
+      // The filesystem has no O_TMPFILE: write to a named file and rename it when done.
+      static size_t counter = 0;
+      result.temporary_name = StringPrintf(".temporary%zu", counter++);
+      result.fd.reset(openat(dir_fd_, result.temporary_name.c_str(),
+                             O_WRONLY | O_APPEND | O_CREAT | O_TRUNC | O_CLOEXEC, 0660));
+    }
     if (result.fd == -1) {
       PLOG(FATAL) << "failed to create temporary tombstone in " << dir_path_;
     }
@@ -408,7 +419,18 @@ static void crash_request_cb(evutil_socket_t sockfd, short ev, void* arg) {
   }
